# Database
DATABASE_URL=postgresql://user:password@localhost:5432/hopcharge_ad_engine

# Anthropic
ANTHROPIC_API_KEY=
# The pipeline Evaluation narrative (a Claude call) is cached in the CachedResult
# table and only recomputed when its inputs change, so page reloads are free. This
# soft TTL forces an eventual refresh even if inputs are unchanged (default 24h).
# EVALUATION_CACHE_TTL_MS=86400000

# Meta
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=

# Video + image generators
# Higgsfield (image: text2image/soul, video: image2video/dop). v2 auth = KEY_ID:KEY_SECRET.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
HIGGSFIELD_ALLOW_GENERATION=false   # credit gate - must be "true" to spend credits
# HIGGSFIELD_SARA_SOUL_ID=          # trained character -> custom_reference_id (image consistency)
# HIGGSFIELD_SARA_REFERENCE_URL=    # public Sara still -> image_reference + video first frame
# HIGGSFIELD_SOUL_SIZE=1536x2048    HIGGSFIELD_SOUL_QUALITY=1080p
# HIGGSFIELD_DOP_MODEL=dop-turbo    HIGGSFIELD_DOP_MOTION_ID=   HIGGSFIELD_DOP_MOTION_STRENGTH=0.8
KLING_API_KEY=
RUNWAY_API_KEY=

# Image generators
REPLICATE_API_KEY=
MIDJOURNEY_API_KEY=

# Plugin selection
IDEA_GENERATOR=stub
# VIDEO_GENERATOR / IMAGE_GENERATOR: an API generator (higgsfield|kling|runway|replicate)
# OR "manual" - no API is called; the app shows you the exact prompt + config to paste
# into Higgsfield (or any tool) and you upload the result back in via the Review page.
VIDEO_GENERATOR=stub
IMAGE_GENERATOR=stub
PUBLISHER_META=stub
PUBLISHER_YOUTUBE=stub
ANALYTICS_META=stub
# Set ANALYTICS_YOUTUBE=youtube to pull organic YouTube video stats (views / likes /
# comments) via the YouTube Data API v3; default stub. Uses the SAME GOOGLE_CLIENT_ID
# + GOOGLE_CLIENT_SECRET + YOUTUBE_REFRESH_TOKEN as PUBLISHER_YOUTUBE. Note: the Data
# API returns lifetime cumulative counters, so each daily snapshot is a running total.
ANALYTICS_YOUTUBE=stub
TREND_DATA=stub
# Trend refresh mode: lite = Google Trends only (free, no AI) | full = + Claude web search & synthesis
TREND_MODE=lite
# WEB_SEARCH: stub | brave (free Brave Search API + Readability article parsing) |
# claude (PAID Claude web_search tool, $10/1000 searches). Leave this UNSET and just
# set BRAVE_API_KEY below - the app then defaults to free Brave search automatically.
# Set WEB_SEARCH=claude only if you deliberately want the paid tool. Claude still does
# the trend/competitor synthesis regardless of which search source is used.
# WEB_SEARCH=brave
# Brave Search (used automatically once this key is set). Free key: https://brave.com/search/api/
BRAVE_API_KEY=
# BRAVE_COUNTRY=IN
# BRAVE_RESULT_COUNT=5            # results per query
# BRAVE_PARSE_RESULTS=3          # top N results to fetch + Readability-parse (0 = off)
# BRAVE_FETCH_TIMEOUT_MS=6000
# BRAVE_MAX_ARTICLE_CHARS=1500
AD_LIBRARY=stub

# Logo overlay - stamps the real public/hopcharge-logo.svg onto every generated image
# (models are told NOT to render a logo). All optional; sensible defaults shown.
# LOGO_OVERLAY_ENABLED=true
# LOGO_OVERLAY_PATH=./public/hopcharge-logo.svg
# LOGO_OVERLAY_CORNER=bottom-right      # top-left | top-right | bottom-left | bottom-right
# LOGO_OVERLAY_WIDTH_PCT=22             # logo width as % of image width
# LOGO_OVERLAY_MARGIN_PCT=4             # margin as % of the shorter side
# LOGO_OVERLAY_OPACITY=0.9              # white backing-chip opacity (0.1–1)
# LOGO_OVERLAY_CHIP=true                # false = stamp bare logo (supply a white/knockout asset)
# LOGO_OVERLAY_VIDEO=true               # false = skip the logo on videos only (images still stamped)
# Video overlay needs ffmpeg + ffprobe on PATH; override the binaries if needed:
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Headline overlay - composites a solid brand-colour band + the idea's headline onto
# every generated image/video (top quarter by default), so the ad carries its own
# on-image message instead of relying only on the platform ad-copy field. All
# optional; sensible defaults shown (bg/accent pulled from the real logo + van colours).
# HEADLINE_OVERLAY_ENABLED=true
# HEADLINE_OVERLAY_POSITION=top         # top | bottom
# HEADLINE_OVERLAY_HEIGHT_PCT=24        # band height as % of frame height
# HEADLINE_OVERLAY_BG=#222E53           # band colour (default: real logo navy)
# HEADLINE_OVERLAY_ACCENT=#D9A441       # thin divider rule (default: van's gold stripe)
# HEADLINE_OVERLAY_TEXT_COLOR=#FFFFFF
# HEADLINE_OVERLAY_FONT=Lato, DejaVu Sans, sans-serif
# HEADLINE_OVERLAY_VIDEO=true            # false = skip the band on videos only (images still get it)

# Storage
# STORAGE_TYPE: "local" (plain disk) or "s3" (any S3-compatible backend).
# Dev default below targets local MinIO (run `npm run storage:up`).
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=./storage
# --- S3 / R2 / MinIO (only used when STORAGE_TYPE=s3) ---
# Local MinIO dev values:
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET=hopcharge-creatives
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# To switch to Cloudflare R2, change the 5 vars above to:
#   AWS_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   AWS_S3_BUCKET=<your-r2-bucket>
#   AWS_REGION=auto
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY=<R2 API token>
# (For real AWS S3 instead: leave AWS_S3_ENDPOINT blank and use your real region.)

# Background job automation master switch.
# Only seeds the master switch's DEFAULT on first boot - after that, automation is
# controlled at runtime from the /automation page (state persists in Postgres).
# false (default) = fully-manual mode: jobs only run when you trigger them via the
#   UI buttons / API endpoints. true = master switch starts ON.
ENABLE_JOB_AUTOMATION=false

# Job schedule overrides (cron syntax). These are defaults; a schedule edited in
# the /automation UI overrides the matching var below.
CRON_TREND_CONTEXT=0 6 * * *
CRON_FEEDBACK_LOOP=0 8 * * *
CRON_SYNC_PERFORMANCE=0 */6 * * *
CRON_POLL_CREATIVES=*/1 * * * *
CRON_RECONCILE_POSTS=0 */12 * * *

# --- Vercel deployment only ---
# On Vercel there is no long-running process, so pg-boss is disabled automatically
# (VERCEL env is set) and the schedule is driven by Vercel Cron hitting the
# /api/cron/<job> endpoints (see vercel.json). Those endpoints still honour the
# /automation master switch + per-job toggles, so set ENABLE_JOB_AUTOMATION=true
# (or flip the master switch in /automation once) or nothing will run.
#
# Shared secret for the cron endpoints. Set the SAME value here and in Vercel;
# Vercel sends it as `Authorization: Bearer $CRON_SECRET` on every scheduled call.
# If left unset, /api/cron/* is UNAUTHENTICATED and anyone can trigger jobs.
CRON_SECRET=

# --- Auth: Google sign-in restricted to @hopcharge.com ---
# The whole app is gated behind Google OAuth (see src/proxy.ts + src/lib/auth.ts).
# Create an OAuth 2.0 "Web application" client in Google Cloud Console with these
# Authorized redirect URIs (must match EXACTLY):
#   https://<your-app>.vercel.app/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
# NOTE: if these three vars are unset in production the app fails closed - every
# route redirects to /signin and sign-in itself errors. They are required.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Signs the session cookie. Generate one with: openssl rand -base64 32
AUTH_SECRET=
# Optional: force the public base URL (otherwise derived from the request host).
# AUTH_URL=https://<your-app>.vercel.app
# Optional: session lifetime in seconds (default 7 days).
# AUTH_SESSION_TTL_SECONDS=604800

# --- YouTube publishing (YouTube Data API v3 - organic Shorts / videos) ---
# Set PUBLISHER_YOUTUBE=youtube to publish generated videos to your channel as regular
# YouTube videos (a 9:16 clip becomes a Short); default stub does not touch any API.
# These are ORGANIC posts, NOT paid ads - there is no ad account, no budget, and no
# scheduling. The video is uploaded via videos.insert; "Draft" mode uploads it as
# PRIVATE (only you can see it), "Production" uploads it PUBLIC. Images can't be
# posted to YouTube, so only video creatives are publishable there.
#
# Requires a Google OAuth 2.0 client with the "YouTube Data API v3" enabled, plus a
# refresh token minted for the channel owner. Get a refresh token once (e.g. via the
# OAuth Playground at https://developers.google.com/oauthplayground, using your own
# client id/secret) with these scopes:
#   https://www.googleapis.com/auth/youtube.upload    (publish videos)
#   https://www.googleapis.com/auth/youtube.readonly  (read stats + reconcile)
#   https://www.googleapis.com/auth/youtube           (flip a video private on pause)
# The single scope https://www.googleapis.com/auth/youtube.force-ssl covers all three.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Draft mode (default true): videos upload PRIVATE (nothing public) until you flip
# them, mirroring META_DRAFT_MODE. Set false to publish PUBLIC immediately.
YOUTUBE_DRAFT_MODE=true
# Video category id (region-specific). 2 = Autos & Vehicles (topical), 22 = People
# & Blogs (safe universal fallback).
# YOUTUBE_CATEGORY_ID=2
# Landing URL put in the video description (falls back to META_WEBSITE_URL).
# YOUTUBE_FINAL_URL=
# Image creatives published to YouTube are converted to a video on the way out
# (still-to-video.ts) since videos.insert rejects a still. Requires ffmpeg (see
# FFMPEG_PATH above).
# YOUTUBE_STILL_VIDEO_DURATION=8    # seconds the still is held for
# YOUTUBE_STILL_KEN_BURNS=true      # false = static frame, no pan/zoom
