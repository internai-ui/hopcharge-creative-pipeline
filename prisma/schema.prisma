generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Idea {
  id               String    @id @default(uuid())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  title            String
  hook             String
  imageVisual      String
  videoVisual      String
  // Still-image prompt for the VIDEO's opening frame (0-3s hook shot). Distinct
  // from imageVisual (the finished standalone poster): this is a proper first
  // frame for image2video, not a fully-resolved ad. Nullable so older rows and
  // the video pipeline can fall back to deriving it from videoVisual.
  videoFirstFrame  String?
  cta              String
  // Meta ad copy: primaryText = the body/message above the creative,
  // headline = the bold line beneath it. Required - every ad needs them; the
  // manual drawer and generators always supply them (backfilled for old rows).
  primaryText      String
  headline         String
  // YouTube (Demand Gen) ad copy. Responsive: several short headlines (<=40 chars)
  // and descriptions (<=90 chars) that Google mixes at serve time, plus a CTA enum.
  // Distinct from Meta's single primaryText+headline (Demand Gen has no free-form
  // body and no WhatsApp CTA). Backfilled by the idea generator; empty = not yet set.
  ytHeadlines      String[]  @default([])
  ytDescriptions   String[]  @default([])
  ytCallToAction   String    @default("LEARN_MORE")
  angle            String
  rank             Int       @default(0)
  status           IdeaStatus @default(pending)
  funnelStage      FunnelStage?
  sourceType       IdeaSourceType @default(ai_generated)
  nudge            String?
  parentIdeaId     String?
  parent           Idea?     @relation("IdeaChildren", fields: [parentIdeaId], references: [id])
  children         Idea[]    @relation("IdeaChildren")
  performanceScore Float?    // avg cost-per-lead in ₹ (lower is better)
  trendTags        String[]  @default([])
  trendScore       Float?
  trendScoredAt    DateTime?
  trendWarning     String?

  creatives        Creative[]

  @@index([status])
  @@index([rank])
}

model Creative {
  id               String          @id @default(uuid())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  ideaId           String
  idea             Idea            @relation(fields: [ideaId], references: [id])
  status           CreativeStatus  @default(generating)
  mediaType        String          @default("video")
  // Platform this creative is built for (chosen at generation) + its aspect ratio.
  // Meta = 9:16 (Reels). YouTube = 9:16 Shorts, and in "both" mode also renders a
  // 16:9 in-stream rendition into landscapeFilePath that ships alongside the 9:16
  // (originalFilePath) inside one Demand Gen responsive ad.
  platform         Platform        @default(meta)
  aspectRatio      String          @default("9:16")
  landscapeFilePath String?
  generatorName    String
  generatorJobId   String?
  originalFilePath String?
  editedFilePath   String?
  isHumanEdited    Boolean         @default(false)
  thumbnailPath    String?
  durationSeconds  Int?
  metadata         Json?

  posts            Post[]

  @@index([status])
  @@index([ideaId])
}

model Post {
  id               String      @id @default(uuid())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  creativeId       String
  creative         Creative    @relation(fields: [creativeId], references: [id])
  platform         Platform
  status           PostStatus  @default(queued)
  scheduledAt      DateTime?
  postedAt         DateTime?
  externalPostId   String?
  platformMetadata Json?
  adSchedule       Json?    // null=run always; {days:[0-6 Sun=0], startHour:0-23, endHour:0-23}

  snapshots        PerformanceSnapshot[]

  @@index([status])
  @@index([platform])
  @@index([creativeId])
}

model PerformanceSnapshot {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  postId       String
  post         Post     @relation(fields: [postId], references: [id])
  snapshotDate DateTime @db.Date
  // Meta: ad impressions. YouTube: view count (see youtube/analytics.ts) - the page
  // must relabel this per platform rather than presenting a YouTube view as an
  // "impression".
  impressions  Int      @default(0)
  reach        Int?     // unique viewers - Meta only, the Data API has no equivalent
  // Meta: link/CTA clicks. YouTube: like count (closest organic engagement analogue).
  clicks       Int      @default(0)
  // Paid-ad economics - null for organic YouTube snapshots, there is no spend/CPL/
  // CPM/frequency on an organic video.
  spend        Decimal? @db.Decimal(10, 2)
  cpl          Decimal? @db.Decimal(10, 2)
  leads        Int      @default(0)
  cpm          Decimal? @db.Decimal(10, 4)
  // Meta: click-through rate. YouTube: engagement rate (likes / views) - same field,
  // different meaning per platform; the page must label it accordingly.
  ctr          Decimal? @db.Decimal(10, 6)
  frequency    Decimal? @db.Decimal(10, 4)
  // YouTube-only real engagement count, previously discarded into rawData.
  commentsCount Int?
  rawData      Json?

  @@index([postId])
  @@index([snapshotDate])
}

model TrendContext {
  id                    String   @id @default(uuid())
  createdAt             DateTime @default(now())
  summary               String
  risingTopics          Json
  decliningTopics       Json
  platformFormatTrends  Json
  competitorAdInsights  String
  rawSources            Json?
  topicScores           Json

  @@index([createdAt])
}

model PipelineIssue {
  id              String         @id @default(uuid())
  createdAt       DateTime       @default(now())
  resolvedAt      DateTime?
  severity        IssueSeverity
  stage           PipelineStage
  description     String
  relatedEntityId String?
  isResolved      Boolean        @default(false)

  @@index([isResolved])
  @@index([severity])
}

model AgentAction {
  id                  String   @id @default(uuid())
  createdAt           DateTime @default(now())
  actionType          String
  decisionRationale   String
  humanOverridden     Boolean  @default(false)
  humanOverrideReason String?
  outcome             String?
  relatedEntityId     String?

  @@index([actionType])
  @@index([createdAt])
}

enum IdeaStatus {
  pending
  selected
  in_production
  published
  archived
}

enum IdeaSourceType {
  ai_generated
  human_added
}

// Marketing funnel stage an idea targets:
//   TOF - top of funnel (awareness / broad reach)
//   MOF - middle of funnel (consideration / nurture)
//   BOF - bottom of funnel (conversion / direct response)
enum FunnelStage {
  TOF
  MOF
  BOF
}

enum CreativeStatus {
  generating
  awaiting_upload
  ready_for_review
  approved
  rejected
  published
}

enum Platform {
  meta
  youtube
}

enum PostStatus {
  queued
  posted
  failed
  // Ad was deleted in Meta Ad Manager after we published it - detected by the
  // reconcile job (src/lib/jobs/reconcile-posts.ts) and surfaced in the queue.
  deleted
}

enum IssueSeverity {
  info
  warning
  critical
}

enum PipelineStage {
  idea_generation
  trend_analysis
  production
  review
  publishing
  analytics
  feedback_loop
}

// Runtime control panel for background job automation (singleton row, id="singleton").
// masterEnabled is the global on/off; jobs is a { [jobName]: boolean } map of which
// individual jobs are allowed to run when the master switch is on. Persisted so the
// choice survives restarts and is re-applied by src/instrumentation.ts at boot.
model AutomationConfig {
  id            String   @id @default("singleton")
  masterEnabled Boolean  @default(false)
  jobs          Json
  // Per-job cron overrides keyed by job name. Missing entries fall back to the
  // env/default cron baked into JOB_DEFS.
  schedules     Json?
  updatedAt     DateTime @updatedAt
}

model HistoricalAd {
  id           String   @id @default(uuid())
  importedAt   DateTime @default(now())
  // A Meta ad ID or a YouTube video ID depending on `platform` - the column name is
  // historic (Meta-only originally) but it's a generic unique external ID now.
  metaAdId     String   @unique
  platform     String   @default("meta") // "meta" | "youtube"
  adName       String
  campaignName String?
  adSetName    String?
  bodyText     String
  headlineText String?
  // Paid-ad economics - meaningful for Meta only. Null for organic YouTube rows:
  // there is no spend or cost-per-lead on an organic video.
  cpl          Float?
  leads        Int      @default(0)
  spend        Float?
  impressions  Int?
  reach        Int?
  clicks       Int?
  cpm          Float?
  ctr          Float?
  frequency    Float?
  // Whether this ad beat the CPL success threshold - Meta only, null for YouTube
  // (there is no equivalent cost-based success bar for an organic video).
  isSuccessful     Boolean?
  // Organic YouTube engagement - null for Meta rows.
  views            Int?
  likesCount       Int?
  commentsCount    Int?
  concepts         Json?
  dateFrom         DateTime
  dateTo           DateTime
  source           String   @default("import")
  hourlyBreakdown  Json?    // [{hour:0-23, impressions, spend, leads, cpl}] - Meta only
  weekdayBreakdown Json?    // [{day:0-6 Sun=0, impressions, spend, leads, cpl}] - Meta only

  // The ad's actual creative. For Meta this is the full image, or the real video file
  // when the ad account exposes a source URL (importHistoricalCreativeImages). For
  // YouTube this is the thumbnail - the Data API has no video-file download endpoint,
  // so externalWatchUrl links out to the real video on youtube.com instead.
  creativeType      String?  // "image" | "video"
  creativeSourceUrl String?  // CDN URL the still/video was fetched from (signed, expires)
  creativeImagePath String?  // storage-relative path to the downloaded still/video file
  externalWatchUrl  String?  // youtube.com/watch?v=... - YouTube only, for real playback

  @@index([isSuccessful])
  @@index([cpl])
  @@index([platform])
}

// User-editable Google Trends keyword taxonomy. Seeded once from the hardcoded
// defaults in src/lib/trend-topics.ts (see src/lib/trend-keywords.ts). Once seeded,
// this table is the source of truth: the trend job reads keywords from here, and the
// Trends page lets the marketer add/remove them per lens.
model TrendKeyword {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  lens      String   // demand | charging | lifestyle | format
  term      String

  @@unique([lens, term])
  @@index([lens])
}

// Generic result cache for expensive-to-recompute payloads (e.g. the Claude pipeline
// evaluation narrative). `signature` is a hash of the inputs the payload was derived
// from: when the inputs change, the signature changes and the cached payload is
// recomputed. Keyed by a stable logical name (e.g. "pipeline-evaluation").
model CachedResult {
  key       String   @id
  signature String
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
